# 飞书AI办公协同智能助手配置

# OpenAI API配置（可以使用其他兼容OpenAI API的服务）
OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1

# 模型配置
MODEL_NAME=gpt-3.5-turbo
# 如果使用其他模型，可以设置为:
# MODEL_NAME=gpt-4
# MODEL_NAME=qwen-plus  # 阿里云通义千问
# MODEL_NAME=ernie-bot  # 百度文心一言

# 应用配置
APP_NAME=Feishu AI Assistant
APP_VERSION=1.0.0
